# ==================== 阿里云凭证 ====================
# 建议使用 RAM 子账号，并授予最小必要权限
# URL：https://ram.console.aliyun.com/users/create
# 需要的 Action：
#   esa:GetOriginProtection
#   esa:UpdateOriginProtectionIpWhiteList
#   ecs:CreatePrefixList
#   ecs:DeletePrefixList
#   ecs:DescribePrefixLists
#   ecs:DescribeSecurityGroupAttribute
#   ecs:AuthorizeSecurityGroup
#   ecs:RevokeSecurityGroup
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ==================== ESA 配置 ====================
# ESA 站点 ID，可在 ESA 控制台站点列表查看
# URL：https://esa.console.aliyun.com/siteManage/list
ESA_SITE_ID=
# ESA 接入点，一般不用改
ESA_ENDPOINT=esa.cn-hangzhou.aliyuncs.com

# ==================== ECS 配置 ====================
# ECS 地域 ID，例如 cn-chengdu、cn-hangzhou
# URL：https://help.aliyun.com/zh/user-center/developer-reference/common-region-id-reference
ECS_REGION_ID=
# 要操作的安全组 ID
# URL：https://ecs.console.aliyun.com/securityGroup
ECS_SECURITY_GROUP_ID=

# ==================== 前缀列表配置 ====================
# 新建前缀列表的名称（IPv4 / IPv6 各一个）
PREFIX_LIST_NAME_V4=ESA节点IP-IPv4
PREFIX_LIST_NAME_V6=ESA节点IP-IPv6
# 前缀列表描述，可留空使用默认值
PREFIX_LIST_DESCRIPTION=ESA源站防护最新回源IP白名单
# 受管前缀列表的名称前缀，用于识别哪些前缀列表归本脚本管理
# 只有名称以此前缀开头的前缀列表，才会被自动清理
MANAGED_NAME_PREFIX=ESA

# ==================== 安全组规则配置 ====================
# 要放行的端口，多个用英文逗号分隔
# 格式：单端口 "80/80"，端口段 "8000/9000"，全部 "-1/-1"
SECURITY_GROUP_PORTS=443/443,80/80
# 协议：TCP / UDP / ICMP / GRE / ALL
SECURITY_GROUP_IP_PROTOCOL=TCP
# 网卡类型：VPC 用 intranet，经典网络用 internet
SECURITY_GROUP_NIC_TYPE=intranet